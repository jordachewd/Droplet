# Droplet — environment template
#
# Copy to `.env.local` and fill in. Never commit `.env.local`.
#   cp .env.local.example .env.local
#
# Variables marked (required) are read through `requireEnv()`; the app throws
# on startup if they are missing. Comments are kept on their own lines so no
# dotenv parser mistakes them for values.

# ── App ──────────────────────────────────────────────────────────────────

# (required) e.g. http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=
# (optional) comma-separated; defaults to localhost,127.0.0.1
NEXT_ALLOWED_DEV_ORIGINS=

# ── MongoDB ──────────────────────────────────────────────────────────────

# (required) primary connection string
MONGODB_URL=
# database name
MONGODB_DB_NAME=
# (optional, recommended) non-SRV URI used if SRV DNS lookup fails
MONGODB_URL_FALLBACK=
# (optional) comma-separated resolvers for loopback-only Node DNS
DNS_FALLBACK_SERVERS=

# ── Clerk (authentication) ───────────────────────────────────────────────

# public by design (pk_...)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# secret (sk_...)
CLERK_SECRET_KEY=
# (required) used by verifyWebhook()
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=
# Local webhook testing: expose port 3000 (e.g. `lt --port 3000`) and register
# https://<your-tunnel>/api/webhooks/clerk in the Clerk dashboard.

# ── Stripe (billing) ─────────────────────────────────────────────────────

# (required) secret
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# (required) from `stripe listen`
STRIPE_WEBHOOK_SECRET=
# Local webhook testing:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe

# ── OpenAI ───────────────────────────────────────────────────────────────

# (required) org_...
OPENAI_ORG=
# (required) proj_...
OPENAI_PRJ=
# (required) secret
OPENAI_KEY=

# ── AWS S3 (media storage) ───────────────────────────────────────────────

# (required)
AWS_S3_REGION=
# (required)
AWS_S3_BUCKET=
# (required)
AWS_S3_ACCESS_ID=
# (required) secret
AWS_S3_SECRET_KEY=

# ── Downloads ────────────────────────────────────────────────────────────

# (optional) extra allowed hosts, comma-separated. Safe defaults are built
# in; this only extends them.
DOWNLOAD_URL_ALLOWLIST=

# ── E2E test accounts (Playwright only; not needed to run the app) ───────

E2E_TEST_USERNAME=
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_ADMIN_USERNAME=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
